{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "张小龙饭否日记 · Design Tokens（机器可读版）。人类可读说明见 design-tokens.md。命名三层：primitive → semantic → component。",
  "color": {
    "primitive": {
      "primary": {
        "50": { "value": "#f0f9ff", "type": "color" },
        "100": { "value": "#e0f2fe", "type": "color" },
        "200": { "value": "#bae6fd", "type": "color" },
        "300": { "value": "#7dd3fc", "type": "color" },
        "400": { "value": "#38bdf8", "type": "color" },
        "500": { "value": "#0ea5e9", "type": "color", "comment": "品牌锚点 brand" },
        "600": { "value": "#0284c7", "type": "color" },
        "700": { "value": "#0369a1", "type": "color" },
        "800": { "value": "#075985", "type": "color" },
        "900": { "value": "#0c4a6e", "type": "color" }
      },
      "accent": {
        "from": { "value": "#F472B6", "type": "color", "comment": "pink-400" },
        "to": { "value": "#FB923C", "type": "color", "comment": "orange-400" }
      },
      "share-gray": {
        "title": { "value": "#111827", "type": "color" },
        "body": { "value": "#1F2937", "type": "color" },
        "muted": { "value": "#9CA3AF", "type": "color" },
        "divider": { "value": "#E5E7EB", "type": "color" }
      }
    },
    "semantic": {
      "background": { "light": { "value": "#fafafa" }, "dark": { "value": "#0a0a0a" } },
      "foreground": { "light": { "value": "#1a1a1a" }, "dark": { "value": "#e5e5e5" } },
      "card-bg": { "light": { "value": "#ffffff" }, "dark": { "value": "#1a1a1a" } },
      "card-hover": { "light": { "value": "#f8f9fa" }, "dark": { "value": "#262626" } },
      "border": { "light": { "value": "#e5e5e5" }, "dark": { "value": "#262626" } },
      "primary": { "light": { "value": "#0ea5e9" }, "dark": { "value": "#0ea5e9" }, "comment": "跨主题沿用" },
      "secondary": { "light": { "value": "#64748b" }, "dark": { "value": "#64748b" }, "comment": "跨主题沿用" }
    },
    "component": {
      "accent-gradient": { "value": "linear-gradient(135deg, #F472B6, #FB923C)", "type": "gradient" },
      "share-card-bg": { "value": "linear-gradient(180deg, #ffffff 0%, #fafafa 100%)", "type": "gradient" },
      "tag": {
        "product": { "lightBg": "#eff6ff", "lightText": "#1d4ed8", "darkBg": "rgb(30 58 138 / .3)", "darkText": "#93c5fd", "share": "#FF6B6B" },
        "insight": { "lightBg": "#faf5ff", "lightText": "#6b21a8", "darkBg": "rgb(88 28 135 / .3)", "darkText": "#d8b4fe", "share": "#4ECDC4" },
        "internet": { "lightBg": "#f0fdf4", "lightText": "#166534", "darkBg": "rgb(22 101 52 / .3)", "darkText": "#86efac", "share": "#45B7D1" },
        "tech": { "lightBg": "#ecfeff", "lightText": "#164e63", "darkBg": "rgb(22 78 99 / .3)", "darkText": "#a5f3fc", "share": "#96CEB4" },
        "book": { "lightBg": "#fffbeb", "lightText": "#78350f", "darkBg": "rgb(120 53 15 / .3)", "darkText": "#fde69a", "share": "#F59E0B" },
        "life": { "lightBg": "#f9fafb", "lightText": "#374151", "darkBg": "rgb(31 41 55)", "darkText": "#d1d5db", "share": "#DDA0DD" },
        "humor": { "lightBg": "#fdf2f8", "lightText": "#be185d", "darkBg": "rgb(190 24 93 / .3)", "darkText": "#fbcfe8", "share": "#FF8C94" },
        "repost": { "lightBg": "#eef2ff", "lightText": "#4338ca", "darkBg": "rgb(55 48 163 / .3)", "darkText": "#c4b5fd", "share": "#60A5FA" },
        "fanfou": { "lightBg": "#ffedd5", "lightText": "#c2410c", "darkBg": "rgb(194 65 12 / .3)", "darkText": "#fdba74", "share": "#FB923C" },
        "apple": { "lightBg": "#f8fafc", "lightText": "#334155", "darkBg": "rgb(30 41 59)", "darkText": "#cbd5e1", "share": "#6B7280" },
        "google": { "lightBg": "#fef2f2", "lightText": "#b91c1c", "darkBg": "rgb(127 29 29 / .3)", "darkText": "#fecaca", "share": "#EF4444" },
        "wechat": { "lightBg": "#ecfdf5", "lightText": "#059669", "darkBg": "rgb(6 95 70 / .3)", "darkText": "#a7f3d0", "share": "#10B981" },
        "philosophy": { "lightBg": "#faf5ff", "lightText": "#6d28d9", "darkBg": "rgb(88 28 135 / .3)", "darkText": "#d8b4fe", "share": "#8B5CF6" },
        "management": { "lightBg": "#f0fdfa", "lightText": "#0f766e", "darkBg": "rgb(19 78 74 / .3)", "darkText": "#99f6e4", "share": "#14B8A6" },
        "default": { "share": "#6B7280", "comment": "兜底" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "var(--font-geist-sans), system-ui, sans-serif" },
      "mono": { "value": "var(--font-geist-mono), monospace" },
      "body": { "value": "system-ui, -apple-system, sans-serif" },
      "share-card": { "value": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif" }
    },
    "fontSize": {
      "xs": { "value": "0.75rem", "px": 12 },
      "sm": { "value": "0.875rem", "px": 14 },
      "base": { "value": "1rem", "px": 16 },
      "lg": { "value": "1.125rem", "px": 18 },
      "xl": { "value": "1.25rem", "px": 20 },
      "2xl": { "value": "1.5rem", "px": 24 },
      "3xl": { "value": "1.875rem", "px": 30 }
    },
    "fontWeight": {
      "normal": 400, "medium": 500, "semibold": 600, "bold": 700
    },
    "lineHeight": {
      "body": 1.6, "card-content": 1.75, "tight": 1.3
    },
    "letterSpacing": {
      "content": "0.01em"
    }
  },
  "spacing": {
    "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "7": 28, "8": 32,
    "grid": 4,
    "comment": "卡片 padding: 16→24(@sm)；标签: 4/10；月份项: 8/16"
  },
  "radius": {
    "pill": "9999px",
    "card": "0.75rem",
    "md": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "share": "20px",
    "scrollbar": "4px"
  },
  "shadow": {
    "card-mobile": "0 1px 3px rgb(0 0 0 / 0.05)",
    "card-hover": "0 10px 15px -3px rgb(0 0 0 / 0.1)",
    "share": "0 20px 60px rgba(0,0,0,0.15)"
  },
  "breakpoint": {
    "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536,
    "css-switches": "639px / 640px / 1023px"
  },
  "motion": {
    "duration": { "fast": "200ms", "base": "300ms", "slide": "320ms" },
    "easing": { "out": "ease-out", "slide": "cubic-bezier(0.33, 1, 0.68, 1)" },
    "pressScale": 0.995,
    "keyframes": ["fadeIn", "slideInFromRight", "slideInFromLeft"]
  },
  "zIndex": {
    "overlay": 100
  },
  "layout": {
    "container-feed": "max-w-2xl",
    "container-md": "max-w-md",
    "container-wide": "max-w-7xl",
    "share-card-width": "360px",
    "scrollbar": "8px"
  },
  "theme": {
    "strategy": "class",
    "default": "light",
    "viewportThemeColor": "#0ea5e9",
    "library": "next-themes"
  }
}
